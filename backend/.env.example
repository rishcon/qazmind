# Database
# SQLite (used by the current Docker deployment):
# DATABASE_URL=sqlite:///./qazmind.db
# PostgreSQL (used by psycopg2 in requirements.txt for local/dev):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qazmind

# Security
SECRET_KEY=change-this-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Mailgun (optional, for password reset emails)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=

# CORS Origins
CORS_ORIGINS=["http://104.248.238.206","http://localhost:5173","http://localhost:3000"]

# AI Limits
AI_EXPLANATIONS_PER_HOUR=10
AI_MAX_TOKENS=300
