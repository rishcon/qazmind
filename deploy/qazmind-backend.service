[Unit]
Description=QazMind FastAPI backend
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/QazMind/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/QazMind/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
